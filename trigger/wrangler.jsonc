// Cron-only Worker that starts the "Update data" GitHub Actions workflow on
// time. GitHub's own `schedule` runs can start hours late; Cloudflare Cron
// Triggers fire on the minute. No HTTP routes: it has no public URL.
//
// Deploy:   pnpm trigger:deploy
// Secret:   pnpm trigger:secret   (fine-grained token, this repo only, Actions: read & write)
{
  "name": "toq-bar-ma-trigger",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // UTC. Almaty is UTC+5: Sunday and Monday at 09:07 and 09:47. AZhK publishes the
    // week's schedule on one of these mornings; a run that finds no changes commits nothing.
    // Day names, not numbers: in Cloudflare cron 1 is Sunday, unlike GitHub's (1 = Monday).
    "crons": ["7 4 * * SUN,MON", "47 4 * * SUN,MON"],
  },
  "vars": {
    "GITHUB_REPO": "2halgas/toq-bar-ma",
    "GITHUB_WORKFLOW": "update-data.yml",
    "GITHUB_REF": "main",
  },
  "observability": { "enabled": true },
}
