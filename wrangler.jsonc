// Cloudflare Workers static assets: serves the `pnpm build:static` export as-is,
// no Worker script. Headers live in public/_headers (copied to out/).
{
  "name": "toq-bar-ma",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    // /ru → ru.html, /ru/ → /ru
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
